    {"id": "courgette", "add": ["courgette"], "when": [{"name": "en", "op": "startsAny", "text": ["squash"]}, {"name": "en", "op": "hasAll", "text": ["zucchini"]}]},
    {"id": "arugula", "add": ["arugula", "rucola"], "when": [{"name": "en", "op": "startsAny", "text": ["salad, rocket"]}]},
    {"id": "green-onion", "add": ["green onion"], "when": [{"name": "en", "op": "startsAny", "text": ["scallion"]}]},
