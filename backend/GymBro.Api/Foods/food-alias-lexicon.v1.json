    {"id": "cilantro", "add": ["cilantro"], "when": [{"name": "en", "op": "startsAny", "text": ["coriander, raw"]}]},
    {"id": "garbanzo", "add": ["garbanzo", "garbanzo beans", "chickpeas"], "when": [{"name": "en", "op": "startsAny", "text": ["chick peas", "peas, chick"]}]},
    {"id": "rutabaga", "add": ["rutabaga"], "when": [{"name": "en", "op": "startsAny", "text": ["swede", "mashed swede"]}], "unlessWords": ["carrot"]},
