    {"id": "coley", "add": ["coley"], "when": [{"name": "en", "op": "startsAny", "text": ["saithe"]}]},
    {"id": "calamari", "add": ["calamari"], "when": [{"name": "en", "op": "startsAny", "text": ["squid"]}]},
    {"id": "bell-pepper", "add": ["bell pepper", "capsicum"], "when": [{"name": "en", "op": "startsAny", "text": ["sweet pepper"]}], "unlessWords": ["powder", "puree", "sauce"]},
    {"id": "ground-beef", "add": ["ground beef"], "when": [{"name": "en", "op": "startsAny", "text": ["beef, minced", "meat, minced beef"]}]},
    {"id": "ground-pork", "add": ["ground pork"], "when": [{"name": "en", "op": "startsAny", "text": ["pork, minced"]}]},
    {"id": "ground-chicken", "add": ["ground chicken"], "when": [{"name": "en", "op": "startsAny", "text": ["chicken, minced"]}]},
    {"id": "ground-lamb", "add": ["ground lamb"], "when": [{"name": "en", "op": "startsAny", "text": ["lamb, minced"]}]},
    {"id": "filet-mignon", "add": ["filet mignon"], "when": [{"name": "en", "op": "startsAny", "text": ["beef, tenderloin"]}]},
