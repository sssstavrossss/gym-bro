    {"id": "yogurt", "add": ["yogurt"], "when": [{"name": "en", "op": "startsAny", "text": ["yoghurt"]}]},
    {"id": "chicken-breast", "add": ["chicken breast", "chicken breast fillet", "kyllingbryst", "kylling bryst"], "when": [{"name": "en", "op": "startsAny", "text": ["chicken fillet", "chicken, fillet"]}], "unlessWords": ["thigh", "drumstick", "nugget", "minced", "liver", "sausage", "wing", "leg"]},
    {"id": "turkey-fillet", "add": ["turkey fillet"], "when": [{"name": "en", "op": "hasAll", "text": ["turkey", "breast"]}], "unlessWords": ["ham"]},
