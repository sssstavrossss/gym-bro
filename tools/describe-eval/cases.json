// Describe a meal accuracy cases. "match" is a case-insensitive pattern on the catalogue name; the shortest
// Matvaretabellen name it matches sets the expected kcal. "grams" only when the note gives an amount (counted
// things use the table's own piece weight). "tolerance" widens the ±35% amount check for a loose amount.
// "optional" foods (oil for frying) may be in the answer or not. A photo case names a file under photos/,
// which is not committed: weigh the meal, take the photo, and write what was on the plate.
[
  { "id": "boiled-eggs", "text": "2 boiled eggs",
    "expect": [ { "match": "^Egg, kokt", "grams": 112 } ] },
  { "id": "bread-butter", "text": "2 slices of wholemeal bread with butter",
    "expect": [ { "match": "^Brød, (grovt|halvgrovt)", "grams": 80 }, { "match": "^Smør", "grams": 10, "tolerance": 0.8 } ] },
  { "id": "coffee-milk", "text": "coffee with a splash of milk",
    "expect": [ { "match": "^Kaffe, traktet" }, { "match": "^(Lettmelk|Helmelk|Melk|Kaffemelk|Ekstra lett)" } ] },
  { "id": "oatmeal-milk", "text": "a bowl of oatmeal made with milk",
    "expect": [ { "match": "^Havregrøt.*med melk" } ] },
  { "id": "chicken-rice", "text": "200 g chicken breast and 150 g rice",
    "expect": [ { "match": "^Kylling, filet", "grams": 200, "tolerance": 0.1 }, { "match": "^Ris, .*kokt", "grams": 150, "tolerance": 0.1 } ] },
  { "id": "banana-apple", "text": "a banana and an apple",
    "expect": [ { "match": "^Banan, rå", "grams": 120 }, { "match": "^Eple,.* rå", "grams": 110, "tolerance": 0.4 } ] },
  { "id": "bolognese", "text": "big plate of pasta bolognese",
    "expect": [ { "match": "^(Pasta|Spagetti).*bolognese", "grams": 450, "tolerance": 0.5 } ] },
  { "id": "cocktail-sausages", "text": "5 cocktail sausages",
    "expect": [ { "match": "^Sosisser", "grams": 100, "tolerance": 0.5 } ] },
  { "id": "orange-juice", "text": "glass of orange juice",
    "expect": [ { "match": "^Appelsinjuice", "grams": 200 } ] },
  { "id": "pils", "text": "half a litre of pils",
    "expect": [ { "match": "^Pils", "grams": 500, "tolerance": 0.1 } ] },
  { "id": "taco", "text": "taco with minced beef, cheese and salsa, 3 shells",
    "alternatives": [
      [ { "match": "^Tacoskjell", "grams": 60 }, { "match": "^Kjøttdeig" }, { "match": "^(Gulost|Goudaost|Pizzaost|Norvegia|Ost|Cheddar|Jarlsberg)" }, { "match": "^(Tacosaus|Salsa|Tomatsalsa)" } ],
      [ { "match": "^Taco med skjell" } ] ] },
  { "id": "brunost", "text": "brunost on 2 slices of bread",
    "expect": [ { "match": "^Brunost", "grams": 32, "tolerance": 0.5 }, { "match": "^(Brød|Loff), ", "grams": 80 } ] },
  { "id": "yoghurt-granola", "text": "200 g natural yoghurt with 40 g granola",
    "expect": [ { "match": "^Yoghurt, naturell", "grams": 200, "tolerance": 0.1 }, { "match": "^(Granola|Müsli)", "grams": 40, "tolerance": 0.1 } ] },
  { "id": "salmon-dinner", "text": "salmon fillet with 3 potatoes and broccoli",
    "expect": [ { "match": "^Laks" }, { "match": "^Potet", "grams": 230, "tolerance": 0.45 }, { "match": "^Brokkoli" } ] },
  { "id": "kneipp-leverpostei", "text": "2 skiver kneippbrød med leverpostei og agurk",
    "expect": [ { "match": "^Brød, .*kneipp", "grams": 80 }, { "match": "^Leverpostei", "grams": 40, "tolerance": 0.8 }, { "match": "^Agurk" } ] },
  { "id": "tea", "text": "en kopp te",
    "expect": [ { "match": "^Te, (svart|grønn)", "grams": 240, "tolerance": 0.5 } ] },
  { "id": "fishcakes", "text": "3 fiskekaker med poteter",
    "expect": [ { "match": "^Fiskekaker", "grams": 165 }, { "match": "^Potet" } ] },
  { "id": "almonds", "text": "a handful of almonds",
    "expect": [ { "match": "^Mandler", "grams": 25, "tolerance": 0.6 } ] },
  { "id": "peanut-rice-cakes", "text": "1 tbsp peanut butter on 2 rice cakes",
    "expect": [ { "match": "^Peanøttsmør", "grams": 15, "tolerance": 0.5 }, { "match": "^Riskaker", "grams": 16, "tolerance": 0.6 } ] },
  { "id": "hot-dogs", "text": "2 hot dogs in bread",
    "expect": [ { "match": "^(Grillpølse|Wienerpølse)", "grams": 125 }, { "match": "^(Pølsebrød|Lompe)" } ] },
  { "id": "fried-eggs", "text": "2 fried eggs",
    "expect": [ { "match": "^Egg, stekt", "grams": 96 }, { "match": "^(Smør|Rapsolje|Olivenolje|Margarin|Olje)", "optional": true } ] },
  { "id": "stir-fry", "text": "chicken stir fry with vegetables",
    "expect": [ { "match": "^Kylling" }, { "match": "^(Wokblanding|Grønnsak|Paprika|Brokkoli)" }, { "match": "^(Rapsolje|Olivenolje|Olje|Soyaolje)", "optional": true } ] },
  { "id": "latte", "text": "a latte",
    "expect": [ { "match": "^Caff?e latte", "grams": 300, "tolerance": 0.5 } ] },
  { "id": "cola-zero", "text": "0.5 l cola zero",
    "expect": [ { "match": "^Brus, cola, kunstig søtet", "grams": 500, "tolerance": 0.1 } ] },
  { "id": "cottage-cheese", "text": "200 g cottage cheese",
    "expect": [ { "match": "^Cottage cheese", "grams": 200, "tolerance": 0.1 } ] },
  { "id": "crispbread-cheese", "text": "2 knekkebrød med gulost",
    "expect": [ { "match": "^Knekkebrød", "grams": 28, "tolerance": 0.6 }, { "match": "gulost|^Ost, ", "grams": 20, "tolerance": 0.8 } ] },
  { "id": "lasagne", "text": "lasagne",
    "expect": [ { "match": "^Lasagne" } ] },
  { "id": "kebab", "text": "kebab",
    "expect": [ { "match": "kebab" } ] },
  { "id": "red-wine", "text": "glass of red wine",
    "expect": [ { "match": "^Rødvin", "grams": 150, "tolerance": 0.4 } ] },
  { "id": "avocado-toast", "text": "avocado toast with an egg",
    "expect": [ { "match": "^Avokado" }, { "match": "^(Brød|Loff)" }, { "match": "^Egg" } ] },
  { "id": "oats-milk", "text": "60 g havregryn med 2 dl lettmelk",
    "expect": [ { "match": "^Havregryn", "grams": 60, "tolerance": 0.1 }, { "match": "^Lettmelk", "grams": 206, "tolerance": 0.15 } ] },
  { "id": "loff-jam", "text": "loff med jordbærsyltetøy",
    "expect": [ { "match": "^(Loff|Brød, fint|Brød, loff|Brød, kjøpt, fint)" }, { "match": "^(Jordbærsyltetøy|Syltetøy)" } ] },
  { "id": "pink-lady", "text": "one pink lady apple",
    "expect": [ { "match": "^Eple, Pink lady", "grams": 125, "tolerance": 0.4 } ] },
  { "id": "coffee-cream", "text": "300 ml kaffe med 2 ss kaffefløte",
    "expect": [ { "match": "^Kaffe, traktet", "grams": 300, "tolerance": 0.1 }, { "match": "^Kaffefløte", "grams": 30, "tolerance": 0.4 } ] },
  { "id": "bun", "text": "en bolle",
    "expect": [ { "match": "^Bolle" } ] },
  { "id": "skyr", "text": "skyr med bringebær",
    "alternatives": [ [ { "match": "^Skyr, bringebær" } ], [ { "match": "^Skyr" }, { "match": "^Bringebær" } ] ] },
  { "id": "tuna-sandwich", "text": "a tuna sandwich",
    "expect": [ { "match": "^(Brød|Loff)" }, { "match": "^Tunfisk" } ] },
  { "id": "milk-glass", "text": "2 glasses of milk",
    "expect": [ { "match": "^(Melk|Lettmelk|Helmelk)", "grams": 400, "tolerance": 0.3 } ] },
  { "id": "butter-tbsp", "text": "a tablespoon of olive oil on salad",
    "expect": [ { "match": "^Olivenolje", "grams": 10, "tolerance": 0.6 }, { "match": "^(Salat|Isbergsalat|Hjertesalat|Ruccola)" } ] },
  { "id": "cheese-slices", "text": "3 skiver gulost",
    "expect": [ { "match": "gulost", "grams": 30 } ] },
  { "id": "oil-spoons", "text": "2 ss rapsolje",
    "expect": [ { "match": "^Rapsolje", "grams": 20, "tolerance": 0.2 } ] },
  { "id": "sugar-coffee", "text": "en kopp kaffe med 2 ts sukker",
    "expect": [ { "match": "^Kaffe, traktet", "grams": 170, "tolerance": 0.5 }, { "match": "^Sukker", "grams": 10, "tolerance": 0.3 } ] },
  { "id": "large-milk", "text": "a large glass of milk",
    "expect": [ { "match": "^(Melk|Lettmelk|Helmelk)", "grams": 320, "tolerance": 0.2 } ] },
  { "id": "porridge-dl", "text": "3 dl havregrøt med melk",
    "note": "\"med melk\" can mean made with milk or milk poured on top.",
    "alternatives": [
      [ { "match": "^Havregrøt.*med melk", "grams": 300, "tolerance": 0.15 } ],
      [ { "match": "^Havregrøt", "grams": 300, "tolerance": 0.15 }, { "match": "^(Melk|Lettmelk|Helmelk)" } ] ] },
  { "id": "not-food", "text": "went for a 5 km run",
    "expect": [] },
  { "id": "photo-bolognese", "text": "", "photo": "photos/bolognese.jpg", "note": "A stock photo, not weighed: food only.",
    "expect": [ { "match": "^(Pasta|Spagetti).*bolognese|^Pasta, " }, { "match": "^Brokkoli", "optional": true }, { "match": "^Erter", "optional": true }, { "match": "^(Rapsolje|Olivenolje|Olje|Smør|Margarin|Vita)", "optional": true } ] },
  { "id": "photo-breakfast", "text": "", "photo": "photos/breakfast.jpg", "note": "A stock photo, not weighed: food only.",
    "expect": [ { "match": "^Egg(erøre)?" }, { "match": "^(Brød|Rugbrød), " }, { "match": "^(Sosisser|Wienerpølse|Grillpølse|Pølse)" }, { "match": "bønner.*tomatsaus|^Bønner" }, { "match": "^Agurk" }, { "match": "^(Skinke|Bacon|Kokt skinke)", "optional": true }, { "match": "^(Rapsolje|Olivenolje|Olje|Smør|Margarin|Vita)", "optional": true } ] },
  { "id": "photo-chicken", "text": "", "photo": "photos/chicken.jpg", "note": "A stock photo, not weighed: food only.",
    "expect": [ { "match": "^Kylling" }, { "match": "^Ris, " }, { "match": "^(Spinat|Salat|Agurk|Paprika|Tomat)" }, { "match": "^(Agurk|Paprika|Tomat|Salat)", "optional": true }, { "match": "^Tranebær", "optional": true }, { "match": "^Pekan", "optional": true }, { "match": "^(Rapsolje|Olivenolje|Olje|Smør|Margarin|Vita)", "optional": true } ] }
]
