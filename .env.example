# Copy this file to .env and fill it in. .env is gitignored.
# Values below are placeholders. Do not put real tenant or client IDs in git.

# Entra External ID, from the external tenant (not a workforce tenant).
# Subdomain only. If the sign-in host is https://contoso.ciamlogin.com/<tenant-id>,
# the subdomain is "contoso".
ENTRA_TENANT_SUBDOMAIN=
ENTRA_TENANT_ID=
ENTRA_SPA_CLIENT_ID=
ENTRA_API_CLIENT_ID=

# Postgres. The password is also the API's password.
# Avoid spaces and quotes unless you wrap the value in double quotes.
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gymbro
POSTGRES_USER=gymbro

# Where the app is published on the host. The default stays on loopback;
# an HTTPS reverse proxy (Tailscale serve) in front of it terminates TLS.
BIND_ADDRESS=127.0.0.1
BIND_PORT=8100
