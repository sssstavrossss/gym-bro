    {"id": "fava", "add": ["fava", "fava beans"], "when": [{"name": "en", "op": "startsAny", "text": ["broad beans"]}]},
    {"id": "green-beans", "add": ["green beans", "french beans", "haricots verts"], "when": [{"name": "en", "op": "startsAny", "text": ["beans, green, french"]}]},
    {"id": "kidney-beans", "add": ["kidney beans"], "when": [{"name": "en", "op": "startsAny", "text": ["beans"]}, {"name": "en", "op": "hasAll", "text": ["kidney"]}]},
    {"id": "brown-cheese", "add": ["brown cheese"], "when": [{"name": "en", "op": "startsAny", "text": ["cheese, whey"]}, {"name": "nb", "op": "hasAll", "text": ["brunost"]}]},
    {"id": "celery-root", "add": ["celery root"], "when": [{"name": "en", "op": "startsAny", "text": ["celeriac"]}]},
    {"id": "snap-peas", "add": ["sugar snap peas", "snap peas"], "when": [{"name": "en", "op": "startsAny", "text": ["peas, sugar-snap", "peas, sugar snap"]}]},
    {"id": "donut", "add": ["donut"], "when": [{"name": "en", "op": "hasAll", "text": ["doughnut"]}]},
    {"id": "crayfish", "add": ["crayfish"], "when": [{"name": "en", "op": "startsAny", "text": ["crawfish"]}]},
    {"id": "butter-beans", "add": ["butter beans"], "when": [{"name": "en", "op": "startsAny", "text": ["lima beans"]}]}
  ]
}
