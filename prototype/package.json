{
  "name": "gymbro-proto",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build && vite build --mode single && cp dist-single/index.html gymbro-prototype.html && rm -rf dist-single && node scripts/inline-icons.mjs",
    "preview": "vite preview --host",
    "shots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "axe-core": "^4.14.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-singlefile": "^2.3.4",
    "vue-tsc": "^3.3.13"
  }
}
